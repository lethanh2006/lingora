{
  "name": "lingora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --conditions=react-server --test tests/content-contracts.test.mjs tests/enrollment-contracts.test.mjs tests/pilot-seed.test.mjs tests/publish-lesson.test.mjs tests/progress-contracts.test.mjs tests/progress-service.test.mjs tests/assessment-contracts.test.mjs tests/publish-flow.test.mjs tests/language-adapter.test.mjs tests/review-scheduler.test.mjs tests/assessment-repository.test.mjs tests/exam-compiler.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-lingora --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "test:seed": "firebase emulators:exec --project demo-lingora --only firestore \"node --conditions=react-server --test tests/firestore-seed.test.mjs\"",
    "test:catalog": "firebase emulators:exec --project demo-lingora --only firestore \"node --conditions=react-server --test tests/firestore-catalog.test.mjs\"",
    "test:enrollment": "firebase emulators:exec --project demo-lingora --only firestore \"node --conditions=react-server --test tests/firestore-enrollment.test.mjs\"",
    "seed:pilot": "node --env-file-if-exists=.env.local --conditions=react-server scripts/seed-pilot.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "^15.27.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
